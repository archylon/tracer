# Example Configuration File
# Copy this to .env and fill in your values

# ============================================================
# REQUIRED SETTINGS
# ============================================================

# Your PulseChain wallet private key (KEEP THIS SECRET!)
KEY=your_private_key_here

# RPC endpoint for PulseChain
RPC_URL=https://rpc.pulsechain.com

# ============================================================
# PROFIT STRATEGY SETTINGS
# ============================================================

# Minimum profit percentage required to execute trade (%)
# Lower = more trades, but less profit per trade
# Higher = fewer trades, but higher profit when they execute
# Recommended: 3-10%
MIN_PROFIT_PCT=5

# Percentage of USDC to recover (0-200)
# 100 = recover exactly what you started with
# 150 = recover initial + 50% more (compounds capital)
# 50 = recover half, let half ride as profit
# 0 = don't recover USDC, maximize Affection position
# Recommended: 80-120%
USDC_RECOVERY_PCT=100

# How to take profit - options:
# "AFFECTION" = Hold profit as Affection tokens
# "PLS" = Convert profit to PLS
# "0x..." = Convert profit to custom token address
PROFIT_TOKEN=PLS

# ============================================================
# STRATEGY EXAMPLES
# ============================================================

# CONSERVATIVE: Recover all capital, take profit in PLS
# MIN_PROFIT_PCT=10
# USDC_RECOVERY_PCT=100
# PROFIT_TOKEN=PLS

# BALANCED: Recover most capital, hold some Affection
# MIN_PROFIT_PCT=5
# USDC_RECOVERY_PCT=80
# PROFIT_TOKEN=AFFECTION

# AGGRESSIVE: Let it ride, maximize Affection position
# MIN_PROFIT_PCT=3
# USDC_RECOVERY_PCT=50
# PROFIT_TOKEN=AFFECTION

# COMPOUND CAPITAL: Grow your USDC base
# MIN_PROFIT_PCT=5
# USDC_RECOVERY_PCT=150
# PROFIT_TOKEN=PLS

# MAXIMUM GROWTH: All in on Affection
# MIN_PROFIT_PCT=2
# USDC_RECOVERY_PCT=0
# PROFIT_TOKEN=AFFECTION

