# Example Configuration File
# Copy this to .env and fill in your values

# ============================================================
# REQUIRED SETTINGS
# ============================================================

# Your PulseChain wallet private key (KEEP THIS SECRET!)
KEY=your_private_key_here

# RPC endpoint for PulseChain
RPC_URL=https://rpc.pulsechain.com

# ============================================================
# PROFIT STRATEGY SETTINGS
# ============================================================

# Minimum profit percentage required to execute trade (%)
# Lower = more trades, but less profit per trade
# Higher = fewer trades, but higher profit when they execute
# Recommended: 3-10%
MIN_PROFIT_PCT=5

# Percentage of profits to reinvest back into Affection (%)
# Higher = more compound growth
# Lower = more profit taking
# Recommended: 50-80%
REINVEST_PCT=70

# Custom profit token address (optional)
# If not set, profits stay in Affection
# Example: Set to PLSX, HEX, INC, etc.
# PROFIT_TOKEN=0x95B303987A60C71504D99Aa1b13B4DA07b0790ab

# ============================================================
# ADVANCED SETTINGS (Optional)
# ============================================================

# Custom token addresses (if different from defaults)
# AFFECTION_TOKEN=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
# USDC_TOKEN=0x15D38573d2feeb82e7ad5187aB8c1D52810B1f07
# WPLS_TOKEN=0xA1077a294dDE1B09bB078844df40758a5D0f9a27

# ============================================================
# STRATEGY EXAMPLES
# ============================================================

# CONSERVATIVE: High profit threshold, high reinvestment
# MIN_PROFIT_PCT=10
# REINVEST_PCT=80

# BALANCED: Medium profit threshold, balanced reinvestment
# MIN_PROFIT_PCT=5
# REINVEST_PCT=70

# AGGRESSIVE: Low profit threshold, lower reinvestment (more profit taking)
# MIN_PROFIT_PCT=3
# REINVEST_PCT=50

# PROFIT MAXIMIZER: Low threshold, no reinvestment (all profit)
# MIN_PROFIT_PCT=2
# REINVEST_PCT=0

# COMPOUND MAXIMIZER: Medium threshold, maximum reinvestment
# MIN_PROFIT_PCT=5
# REINVEST_PCT=90
